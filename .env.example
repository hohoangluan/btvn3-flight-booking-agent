# Copy this file to .env and fill in your values. Do NOT commit .env.

# API key for the 9router gateway (OpenAI-compatible). Required.
NINEROUTER_API_KEY=your-9router-api-key-here

# OpenAI-compatible base URL of 9router. Optional (default: http://localhost:20128/v1).
NINEROUTER_URL=http://localhost:20128/v1

# Model served by 9router. Optional (default in code: ag/gemini-3.8-flash).
NINEROUTER_MODEL=ag/gemini-3.8-flash-low
